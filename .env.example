# Authentication uses Azure CLI locally and managed identity in Azure.
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=manuals
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<document-intelligence>.cognitiveservices.azure.com
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=manual-chunks
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_AGENT_ID=<existing-agent-id>
# Optional when the project has multiple Azure AI Search connections.
AZURE_FOUNDRY_SEARCH_CONNECTION_NAME=
MANUAL_CHUNK_SIZE=1800
MANUAL_CHUNK_OVERLAP=200
